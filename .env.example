# Copy to .env for local development: matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://recipe_hub:recipe_hub@localhost:5432/recipe_hub

S3_BUCKET=recipe-hub-images
S3_REGION=us-east-1
# Leave unset in production to use AWS S3.
S3_ENDPOINT_URL=http://localhost:9000

# Read by boto3 directly. In production prefer an IAM role over keys.
AWS_ACCESS_KEY_ID=recipe_hub
AWS_SECRET_ACCESS_KEY=recipe_hub_secret
